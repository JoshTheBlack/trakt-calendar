# VCS / CI
.git/
.github/
.gitignore
.dockerignore

# Python env / caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local settings & runtime data (never bake secrets/state into the image)
.claude/
data/
config.php
.env

# Non-runtime / legacy assets. CHANGELOG.md is deliberately absent: the app
# SERVES it (app/changelog.py reads it from the project root for the "What's
# new" modal), so the Dockerfile copies it in and excluding it here breaks the
# build outright.
*.php
images/
LICENSE
README.md
PLANNING.md
